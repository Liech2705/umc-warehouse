{
  "name": "umc-warehouse-server",
  "version": "1.0.0",
  "description": "Warehouse Management System - Backend API",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "dev": "nodemon server.js",
    "postinstall": "npx sequelize-cli db:migrate",
    "lint": "npx --no-install eslint src --ext .js server.js",
    "lint:fix": "npx --no-install eslint src --ext .js server.js --fix",
    "format": "npx --no-install prettier --write \"src/**/*.js\" \"server.js\""
  },
  "engines": {
    "node": ">=20.0.0"
  },
  "dependencies": {
    "bcryptjs": "2.4.3",
    "cors": "2.8.5",
    "dotenv": "16.4.7",
    "exceljs": "^4.4.0",
    "express": "4.21.2",
    "jsonwebtoken": "9.0.2",
    "morgan": "1.10.0",
    "mysql2": "3.11.5",
    "sequelize": "6.37.8"
  },
  "devDependencies": {
    "eslint": "^10.6.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-n": "^18.2.1",
    "eslint-plugin-prettier": "^5.5.6",
    "nodemon": "3.1.9",
    "prettier": "^3.9.4",
    "sequelize-cli": "6.6.2"
  }
}
